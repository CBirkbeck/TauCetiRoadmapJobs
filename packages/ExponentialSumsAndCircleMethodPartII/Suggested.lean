import Mathlib

/-!
# Exponential sums and the circle method, part II: target signatures

The roadmap is README.md; this file is not the roadmap. It states the roadmap's
headline theorems against the pinned APIs.

Not statable at the pins with a few simple definitions:
* The finite-grid degree bound and polynomial-box specialization lack the
  geometric cumulative-degree interface for affine algebraic sets.
* Fourier orthogonality, signed configuration strata and the normalized first
  page, universal monodromy parity, geometric cohomological Weyl differencing,
  and conservative minor-arc vanishing/comparison lack bounded constructible
  finite-extension-adic categories with compact-support six operations,
  Artin-Schreier objects and relative spectral-sequence comparison.
* End winding, the compact-open double-loop obstruction and the trace-pairing
  counterexample lack the prescribed projective-germ mapping-space carrier,
  its topology, local lifts and singular/adic comparison.
* Conditional degeneration lacks the stronger germ-space carrier, the actual
  trace/cup-product pairing and configuration/loop comparison.

The two algebraic headlines use native polynomial coordinate rings. Algebraic
closedness makes their Jacobian conditions exact smoothness tests and makes
irreducibility geometric. A prime radical does not assert reducedness.
-/

namespace TauCetiRoadmap.ExponentialSumsAndCircleMethodPartII

open scoped BigOperators

/-! ## Layer 3: polynomial maps and compact-support Fourier transform -/

/-- Universal coordinate polynomial with a fixed leading coefficient and `d`
independent lower coefficients per coordinate. -/
noncomputable def mappingPolynomial {K : Type*} [Field K] {n : ℕ}
    (d : ℕ) (x : Fin n → K) (j : Fin n) :
    Polynomial (MvPolynomial (Fin d × Fin n) K) :=
  Polynomial.C (MvPolynomial.C (x j)) * Polynomial.X ^ d +
    ∑ i : Fin d, Polynomial.C (MvPolynomial.X (i, j)) * Polynomial.X ^ i.val

/-- The hypersurface equation evaluated on the universal fixed-leading tuple. -/
noncomputable def mappingEquation {K : Type*} [Field K] {n : ℕ}
    (d : ℕ) (f : MvPolynomial (Fin n) K) (x : Fin n → K) :
    Polynomial (MvPolynomial (Fin d × Fin n) K) :=
  MvPolynomial.eval₂Hom (Polynomial.C.comp MvPolynomial.C)
    (mappingPolynomial d x) f

/-- The ideal generated by every coefficient of the evaluated equation. -/
noncomputable def mappingIdeal {K : Type*} [Field K] {n : ℕ}
    (d : ℕ) (f : MvPolynomial (Fin n) K) (x : Fin n → K) :
    Ideal (MvPolynomial (Fin d × Fin n) K) :=
  Ideal.span (Set.range (mappingEquation d f x).coeff)

/-! ## Layer 10: comparison, spreading and irreducible mapping schemes -/

/-- A smooth affine hypersurface with smooth leading boundary has geometrically
irreducible fixed-leading-vector mapping scheme of dimension `d * (n - k)` in
the conservative circle-method range. The affine and projective smoothness
conditions are expressed by the Jacobian criterion over an algebraically closed
field of characteristic zero or greater than `k`. -/
theorem mapping_geometrically_irreducible
    {K : Type*} [Field K] [IsAlgClosed K]
    (n k d : ℕ) (f : MvPolynomial (Fin n) K) (x : Fin n → K)
    (hk : 3 ≤ k) (hd : k - 1 ≤ d)
    (hchar : ringChar K = 0 ∨ k < ringChar K)
    (hdegree : f.totalDegree = k)
    (haff : ∀ a : Fin n → K, MvPolynomial.eval a f = 0 →
      ∃ j : Fin n, MvPolynomial.eval a (MvPolynomial.pderiv j f) ≠ 0)
    (hinfty : ∀ a : Fin n → K, a ≠ 0 →
      MvPolynomial.eval a (MvPolynomial.homogeneousComponent k f) = 0 →
      ∃ j : Fin n, MvPolynomial.eval a
        (MvPolynomial.pderiv j (MvPolynomial.homogeneousComponent k f)) ≠ 0)
    (hx : x ≠ 0)
    (hinc : MvPolynomial.eval x (MvPolynomial.homogeneousComponent k f) = 0)
    (hn : 2 ^ k * (k - 1) < n)
    (hrange : (k - 1 : ℚ) < (d / (k - 1) : ℕ) *
      ((n : ℚ) / 2 ^ k - k + 1)) :
    (mappingIdeal d f x).radical.IsPrime ∧
      ringKrullDim (MvPolynomial (Fin d × Fin n) K ⧸ mappingIdeal d f x) =
        (d * (n - k) : ℕ) := by
  sorry

/-- For `Y₁^(k-1)Y₂ + Y₂^k + sum_{j≥3} Y_j^k + 1` and leading vector
`(1,0,...,0)`, the mapping dimension is at least `d(N-k)-d+k-1` when
`1 ≤ d < k-1`, where `N=n+3`. Moving `kd` to the dimension side expresses
this signed bound without truncating a negative expected dimension. -/
theorem small_degree_excess_dimension
    {K : Type*} [Field K] [IsAlgClosed K]
    (n k d : ℕ) (hk : 3 ≤ k) (hd : 1 ≤ d) (hdk : d < k - 1)
    (hchar : ringChar K = 0 ∨ k < ringChar K) :
    let f : MvPolynomial (Fin (n + 3)) K :=
      MvPolynomial.X 0 ^ (k - 1) * MvPolynomial.X 1 +
      MvPolynomial.X 1 ^ k +
      (∑ j : Fin (n + 3), if 2 ≤ j.val then MvPolynomial.X j ^ k else 0) + 1
    let x : Fin (n + 3) → K := fun j => if j = 0 then 1 else 0
    (d * (n + 2) + k - 1 : ℕ) ≤
      ringKrullDim (MvPolynomial (Fin d × Fin (n + 3)) K ⧸ mappingIdeal d f x) +
        (k * d : ℕ) := by
  sorry

end TauCetiRoadmap.ExponentialSumsAndCircleMethodPartII
