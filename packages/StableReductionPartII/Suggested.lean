import Mathlib

/-!
# Stable reduction, Part II: target signatures

The roadmap is README.md; this file is not the roadmap. It states the roadmap's
headline theorems against the pinned APIs.

Not statable at the pins:
* The formally versal pointed-node hull lacks nodal deformation groupoids and formal hulls.
* Relative stable reflexivity with arbitrary-coefficient Hom exchange and completed
  local transfer lacks coherent sheaf Ext and completion comparison interfaces.
* Expansion–contraction and the universal-curve equivalence lack pointed stable
  families, their moduli stacks, and relative Proj of the expansion sheaf.
* Decorated boundary normalization and smoothing conormal descent lack clutching,
  algebraic-stack normalization, and marking cotangent lines.
* Connected fine symplectic curve level lacks the polarized relative Jacobian and
  curve level moduli with the pairing and dual/twist comparison.
* The integral Noether isomorphism lacks stable moduli, Hodge pushforward,
  determinant of cohomology, and the Deligne pairing.
* Stable compactification after finite base change lacks stable-family and
  classifying-stack carriers.
* Compactified Torelli and Hodge nefness/bigness lack relative Jacobians,
  Siegel minimal compactifications, Torelli, and line positivity interfaces.
* Degree-Picard parameters, lifting obstructions and torsors, and infinitesimal
  Hodge comparison lack relative Picard and stack cohomology carriers.

The polynomial results are independent local headline theorems, not substitutes
for any of these geometric theorems.
-/

namespace TauCetiRoadmap.StableReductionPartII

/-! ## Layer 2: universal curves and the full pointed stable range -/

universe u v

noncomputable section

/-- The equation q(X,Y) - q(s,t), where q(X,Y) = X² + γXY + δY². -/
def pointedNodeEquation (A : Type u) [CommRing A] (γ δ s t : A) :
    MvPolynomial (Fin 2) A :=
  MvPolynomial.X 0 ^ 2 + MvPolynomial.C γ * MvPolynomial.X 0 * MvPolynomial.X 1 +
    MvPolynomial.C δ * MvPolynomial.X 1 ^ 2 - MvPolynomial.C (s ^ 2 + γ * s * t + δ * t ^ 2)

/-- The actual polynomial quotient by the pointed quadratic equation. -/
abbrev pointedNodeRing (A : Type u) [CommRing A] (γ δ s t : A) :=
  MvPolynomial (Fin 2) A ⧸ Ideal.span {pointedNodeEquation A γ δ s t}

/-- The section ideal generated by the coordinate differences X-s and Y-t. -/
def pointedSectionIdeal (A : Type u) [CommRing A] (γ δ s t : A) :
    Ideal (pointedNodeRing A γ δ s t) :=
  Ideal.span {
    Ideal.Quotient.mk _ (MvPolynomial.X 0) - algebraMap A _ s,
    Ideal.Quotient.mk _ (MvPolynomial.X 1) - algebraMap A _ t}

/-- The left node-section matrix, with columns (a,-c) and (b,d). -/
def nodePhi (A : Type u) [CommRing A] (γ δ s t : A) :
    Matrix (Fin 2) (Fin 2) (pointedNodeRing A γ δ s t) :=
  let u := Ideal.Quotient.mk (Ideal.span {pointedNodeEquation A γ δ s t}) (MvPolynomial.X 0)
  let v := Ideal.Quotient.mk (Ideal.span {pointedNodeEquation A γ δ s t}) (MvPolynomial.X 1)
  let ι := algebraMap A (pointedNodeRing A γ δ s t)
  Matrix.of ![![ι δ * v + ι δ * ι t + ι γ * u, u + ι s + ι γ * ι t],
    ![-(u - ι s), v - ι t]]

/-- The right node-section matrix, the adjugate of the left matrix. -/
def nodePsi (A : Type u) [CommRing A] (γ δ s t : A) :
    Matrix (Fin 2) (Fin 2) (pointedNodeRing A γ δ s t) :=
  let u := Ideal.Quotient.mk (Ideal.span {pointedNodeEquation A γ δ s t}) (MvPolynomial.X 0)
  let v := Ideal.Quotient.mk (Ideal.span {pointedNodeEquation A γ δ s t}) (MvPolynomial.X 1)
  let ι := algebraMap A (pointedNodeRing A γ δ s t)
  Matrix.of ![![v - ι t, -(u + ι s + ι γ * ι t)],
    ![u - ι s, ι δ * v + ι δ * ι t + ι γ * u]]

/-- The node-section complex and its transpose remain exact after tensoring over A
with any A-module. No discriminant, Noetherian, domain, or flatness hypothesis is
needed for this polynomial theorem. Knudsen §3 gives the nodal starting point;
monic division and coefficient-flat cokernels give the arbitrary-ring extension. -/
theorem nodeSection_universallyExact
    (A : Type u) [CommRing A] (γ δ s t : A)
    (N : Type v) [AddCommGroup N] [Module A N] :
    let f := (nodePhi A γ δ s t).mulVecLin.restrictScalars A
    let g := (nodePsi A γ δ s t).mulVecLin.restrictScalars A
    let ft := (nodePhi A γ δ s t).transpose.mulVecLin.restrictScalars A
    let gt := (nodePsi A γ δ s t).transpose.mulVecLin.restrictScalars A
    Function.Exact (f.rTensor N) (g.rTensor N) ∧
      Function.Exact (g.rTensor N) (f.rTensor N) ∧
      Function.Exact (ft.rTensor N) (gt.rTensor N) ∧
      Function.Exact (gt.rTensor N) (ft.rTensor N) := by
  sorry

/-- Canonical evaluation into the double dual is an isomorphism for the actual
polynomial section ideal and its ring-linear dual, over every commutative base,
including a zero ring or a repeated quadratic root. -/
theorem pointedSection_reflexive
    (A : Type u) [CommRing A] (γ δ s t : A) :
    Module.IsReflexive (pointedNodeRing A γ δ s t) (pointedSectionIdeal A γ δ s t) ∧
      Module.IsReflexive (pointedNodeRing A γ δ s t)
        (Module.Dual (pointedNodeRing A γ δ s t) (pointedSectionIdeal A γ δ s t)) := by
  sorry

end

end TauCetiRoadmap.StableReductionPartII
