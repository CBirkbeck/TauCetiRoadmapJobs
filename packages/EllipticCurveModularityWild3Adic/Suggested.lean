import Mathlib

/-!
# EllipticCurveModularityWild3Adic: target signatures

The roadmap is README.md; this file is not the roadmap. It states the roadmap's headline
local arithmetic theorems against the pinned Mathlib and Tau Ceti APIs: the cube-class basis
of ℚ₃ (§1.1), the cyclic cubic extension (§1.3), and the splitting-field degrees (§§1.4–1.7).

The remaining headlines are not statable at the pins. Simple admittance (§§0.6–0.8) lacks the
compact-type and residual-admittance carriers. Breuil classification and wild descent (§§2.1–2.4)
lack finite flat group-scheme and Breuil-module carriers with descent. The tangent bounds and
weak acceptability (§§3.8–3.9, 4.6–4.7, 5.8–5.12) lack local deformation rings with these type
conditions. The cross-prime comparison (§1.13) lacks abelian-variety Tate realizations and the
p-adic Weil–Deligne functor. Rationality and the companion construction (§1.15, §§6.1–6.3) lack
twisted modular curves and their universal elliptic curve. The lifting and modularity theorems
(§§6.5–6.13) lack arithmetic newforms, their attached Galois representations, modularity predicates
and modular parametrizations. The finite-field and scalar computations used in these results
are README Checks.
-/

noncomputable section

namespace TauCetiRoadmap.EllipticCurveModularityWild3Adic

/-- `ℚ₃`. -/
abbrev Q3 := ℚ_[3]

/-- A fixed algebraic closure of `ℚ₃`, containing all the explicit fields of Layer W3.1. -/
abbrev Q3bar := AlgebraicClosure Q3

/-! ## Layer W3.1: Local arithmetic of ℚ₃ -/

/-- Every nonzero 3-adic number has unique cube-class coordinates in the basis [3], [4] (§1.1). -/
theorem cubeClass_coordinates (y : Q3) (hy : y ≠ 0) :
    ∃! ab : Fin 3 × Fin 3, ∃ x : Q3,
      y = (3 : Q3) ^ ab.1.val * (4 : Q3) ^ ab.2.val * x ^ 3 := by
  sorry

/-- `F₁ = ℚ₃(π)` (README 1.3). -/
def cyclicCubicField (π : Q3bar) : IntermediateField Q3 Q3bar := IntermediateField.adjoin Q3 {π}

/-- `F′₋₁ = ℚ₃(π, j)` (README 1.4). -/
def nonabelianCubicSplittingField (π j : Q3bar) : IntermediateField Q3 Q3bar :=
  IntermediateField.adjoin Q3 {π, j}

/-- `F′₃`, `F′₋₃` and `F′_i` are all of the form `ℚ₃(s, j, α, β)` (README 1.5–1.7). -/
def degreeTwelveSplittingField (s j α β : Q3bar) : IntermediateField Q3 Q3bar :=
  IntermediateField.adjoin Q3 {s, j, α, β}

/-- README 1.3: `F₁/ℚ₃` is cyclic of degree three, generated by `π ↦ π² - 2π`. -/
theorem cyclicCubic_galois (π : Q3bar) (hπ : π ^ 3 - 3 * π ^ 2 + 3 = 0) :
    Module.finrank Q3 (cyclicCubicField π) = 3 ∧ IsGalois Q3 (cyclicCubicField π) ∧
      ∃ σ : cyclicCubicField π ≃ₐ[Q3] cyclicCubicField π, orderOf σ = 3 ∧
        ((σ ⟨π, IntermediateField.mem_adjoin_simple_self Q3 π⟩ : cyclicCubicField π) : Q3bar) =
          π ^ 2 - 2 * π := by
  sorry

/-- README 1.4: the degrees of the nonabelian cubic field and of its splitting field. -/
theorem nonabelianCubic_finrank (π j : Q3bar) (hπ : π ^ 3 - 3 * π ^ 2 + 6 = 0) (hj : j ^ 2 = -1) :
    Module.finrank Q3 (IntermediateField.adjoin Q3 {π}) = 3 ∧
      Module.finrank Q3 (nonabelianCubicSplittingField π j) = 6 ∧
      ¬ IsGalois Q3 (IntermediateField.adjoin Q3 {π}) := by
  sorry

/-- README 1.5–1.7: each degree-twelve splitting field has degree 24 over `ℚ₃`. The three
families differ only in the hypotheses on `s`, `α`, `β`. -/
theorem positiveQuadratic_finrank (s j α β : Q3bar) (hs : s ^ 2 = 3) (hj : j ^ 2 = -1)
    (hα : α ^ 3 - 3 * α + 3 = 0) (hβ : β ^ 2 = s) :
    Module.finrank Q3 (degreeTwelveSplittingField s j α β) = 24 := by
  sorry

/-- The splitting field of the negative quadratic wild type has degree 24 over ℚ₃ (§1.6). -/
theorem negativeQuadratic_finrank (s j α β : Q3bar) (hs : s ^ 2 = -3) (hj : j ^ 2 = -1)
    (hα : α ^ 3 = 4) (hβ : β ^ 2 = -s) :
    Module.finrank Q3 (degreeTwelveSplittingField s j α β) = 24 := by
  sorry

/-- Each conductor-243 splitting field has degree 24 over ℚ₃ (§1.7). -/
theorem extendedTypeField_finrank (i : Fin 3) (s j α β : Q3bar) (hs : s ^ 2 = -3)
    (hj : j ^ 2 = -1) (hα : α ^ 3 = 3 * (1 + 3 * (i.val : Q3bar))) (hβ : β ^ 2 = -s) :
    Module.finrank Q3 (degreeTwelveSplittingField s j α β) = 24 := by
  sorry

end TauCetiRoadmap.EllipticCurveModularityWild3Adic
