namespace TauCetiRoadmap.GeometryOfNumbersAndQuadraticArithmeticPartII

/-! ## Layer 2: dyadic completion and quadratic rigidity -/

/-- For a Dedekind domain in which two is nonzero, its two-adic completion is,
canonically as an algebra over the domain, the product of its prime-adic
completions at the nonzero primes containing two, and also the product of the
integer rings in the corresponding valuation completions. The empty product is allowed. -/
theorem dyadicCompletionDecomposition
    (R : Type*) [CommRing R] [IsDedekindDomain R]
    (hTwo : (2 : R) ≠ 0) :
    Nonempty (AdicCompletion (Ideal.span ({(2 : R)} : Set R)) R ≃ₐ[R]
      ((p : {p : IsDedekindDomain.HeightOneSpectrum R // (2 : R) ∈ p.asIdeal}) →
        AdicCompletion p.val.asIdeal R)) ∧
    Nonempty (AdicCompletion (Ideal.span ({(2 : R)} : Set R)) R ≃ₐ[R]
      ((p : {p : IsDedekindDomain.HeightOneSpectrum R // (2 : R) ∈ p.asIdeal}) →
        p.val.adicCompletionIntegers (FractionRing R))) := by
  sorry

/-! ## Layer 4: explicit dyadic Witt arithmetic -/

noncomputable section

/-- The binary class with diagonal coefficients one and minus two in the native
field Witt ring of Q_2. The inverse of two is carried explicitly. -/
def q2V [Invertible (2 : ℚ_[2])] : TauCeti.WittRing ℚ_[2] :=
  TauCeti.wittClass (Quotient.mk (TauCeti.regularFormSetoid ℚ_[2])
    ⟨2, ![1, Units.mk0 (-2) (by norm_num)]⟩)

/-- The binary class with diagonal coefficients one and three in the native
field Witt ring of Q_2. -/
def q2C [Invertible (2 : ℚ_[2])] : TauCeti.WittRing ℚ_[2] :=
  TauCeti.wittClass (Quotient.mk (TauCeti.regularFormSetoid ℚ_[2])
    ⟨2, ![1, Units.mk0 3 (by norm_num)]⟩)

/-- The coordinate expression a times the unit line plus b times the binary
class with coefficients one and minus two plus d times the binary class with
coefficients one and three, using least nonnegative representatives. -/
def q2Coordinates [Invertible (2 : ℚ_[2])]
    (x : ZMod 8 × ZMod 2 × ZMod 2) : TauCeti.WittRing ℚ_[2] :=
  x.1.val • 1 + x.2.1.val • q2V + x.2.2.val • q2C

/-- The Witt ring of Q_2 has additive coordinates Z/8, Z/2, Z/2 on the unit
line and the two specified binary classes. Multiplication by the class with
coefficients one and three sends (a,b,d) to 4b times the unit plus a times that
binary class. In particular its principal ideal has order four and its
annihilator is generated by twice the unit and that binary class, of type
Z/4 plus Z/2. Source: the corrected calculation of Paper III, Example 2.3.14. -/
theorem q2WittRingPresentation [Invertible (2 : ℚ_[2])] :
    ∃ e : (ZMod 8 × ZMod 2 × ZMod 2) ≃+ TauCeti.WittRing ℚ_[2],
      (∀ x, e x = q2Coordinates x) ∧
      (∀ x, q2C * e x = x.2.1.val • (4 • (1 : TauCeti.WittRing ℚ_[2])) +
        x.1.val • q2C) := by
  sorry

/-! ## Layer 5: Eisenstein arithmetic -/

/-- In the quadratic extension of Q_2 with ordered basis (1,s), s squared is
minus three, restriction has kernel the ideal generated by the specified binary
class. Transfer for the second-coordinate functional has kernel the restriction
image and image the annihilator of that binary class. These are the maps giving
the field restriction cokernel, rather than an abstract cardinality assertion. -/
theorem eisensteinFieldWittExactness [Invertible (2 : ℚ_[2])]
    (E : Type*) [Field E] [Algebra ℚ_[2] E] [FiniteDimensional ℚ_[2] E]
    (b : Module.Basis (Fin 2) ℚ_[2] E) (hOne : b 0 = 1)
    (hSquare : b 1 * b 1 = (-3 : E)) :
    letI : Invertible (2 : E) := TauCeti.invertibleTwoOfBaseField ℚ_[2] E
    let θ := TauCeti.WittRing.baseChange (K := ℚ_[2]) (L := E)
    let s : E →ₗ[ℚ_[2]] ℚ_[2] := b.coord 1
    let hs : s ≠ 0 := by
      intro h
      have h' := congrArg (fun t : E →ₗ[ℚ_[2]] ℚ_[2] => t (b 1)) h
      simp [s] at h'
    let t := TauCeti.WittRing.scharlauTransfer s hs
    (∀ x, θ x = 0 ↔ ∃ y, x = q2C * y) ∧
      Set.range θ = {z | t z = 0} ∧
      Set.range t = {z | q2C * z = 0} := by
  sorry

end

end TauCetiRoadmap.GeometryOfNumbersAndQuadraticArithmeticPartII
