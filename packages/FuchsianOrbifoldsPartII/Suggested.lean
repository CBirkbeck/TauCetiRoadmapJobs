import Mathlib
import TauCeti.Analysis.Complex.UpperHalfPlane.PSL.Action

/-!
# Fuchsian orbifolds, Part II: target signatures

The roadmap is README.md; this file is not the roadmap. It states the roadmap's
headline theorems against the pinned APIs.

The general finite-area Nielsen-core theorem and bordered Gauss–Bonnet are not
statable at the pins: the ideal-hull, bordered core and its signature are missing.
The primitive finite-arc boundary partition and comparison with the arithmetic
surface lack the reduced-period/axis-cycle and bordered-core carriers.
The reflected double, conformal lifting and recovery of the narrow ideal class
lack bordered conformal orbifolds and their doubles. Complementarity and exact
family/genus covering lack class-indexed arithmetic surfaces, projections and
area measures. The improper cusp-flux Stokes theorem and its completed
critical-line endpoint lack oriented core-boundary integration and class-indexed
core domains. No replacement predicates or assumed geometric data encode these
results here. The arithmetic surface, its signature and primitive length, the
oriented boundary comparison and integrable Stokes specialization are consumed
from suppliers named in README.md.
-/

namespace TauCetiRoadmap.FuchsianOrbifoldsPartII

open scoped MatrixGroups

/-! ## Layer 1: quadratic cycles and their Ford polygons -/

/-- An admissible cycle is nonempty, has every digit at least two, and has
at least one digit greater than two. Arithmetic periods additionally are primitive. -/
def AdmissibleCycle (n : List ℕ) : Prop :=
  n ≠ [] ∧ (∀ a ∈ n, 2 ≤ a) ∧ ∃ a ∈ n, 2 < a

/-- The subgroup generated by the width-sum translation and the half-turns at
prefix-sum centres. The definition also accepts nonadmissible lists. -/
noncomputable def cycleGroup (n : List ℕ) : Subgroup PSL(2, ℤ) :=
  Subgroup.closure
    ({(ModularGroup.T : PSL(2, ℤ)) ^ n.sum} ∪
      Set.range (fun k : Fin n.length =>
        (ModularGroup.T : PSL(2, ℤ)) ^ ((n.take k.val).sum : ℤ) *
          (ModularGroup.S : PSL(2, ℤ)) *
          (ModularGroup.T : PSL(2, ℤ)) ^ (-((n.take k.val).sum : ℤ))))

/-- The closed width-sum strip outside the unit discs at all prefix centres,
including both end centres. Ideal intervals are not points of this set. -/
def cyclePolygon (n : List ℕ) : Set UpperHalfPlane :=
  {z | 0 ≤ z.re ∧ z.re ≤ (n.sum : ℝ) ∧
    ∀ k ∈ Finset.range (n.length + 1),
      1 ≤ Complex.normSq ((z : ℂ) - ((n.take k).sum : ℂ))}

/-- The cycle polygon is a measurable fundamental domain up to area-zero
boundary ties for the effective cycle subgroup (DIT16, Theorem 1, p.957). -/
theorem cyclePolygon_fundamentalDomain (n : List ℕ) (hn : AdmissibleCycle n) :
    MeasureTheory.IsFundamentalDomain (cycleGroup n) (cyclePolygon n)
      (MeasureTheory.volume : MeasureTheory.Measure UpperHalfPlane) := by
  sorry

/-- The cycle group is the free product of one infinite cyclic group and one
order-two group for each digit. No arithmetic primitivity is required. -/
theorem cycleGroup_presentation (n : List ℕ) (hn : AdmissibleCycle n) :
    Nonempty (Monoid.Coprod (Multiplicative ℤ)
      (Monoid.CoprodI (fun _ : Fin n.length => Multiplicative (ZMod 2))) ≃*
        cycleGroup n) := by
  sorry

/-- The full cusp subgroup at infinity consists exactly of translations by
multiples of the digit sum, expressed by intersection with the ambient cusp group. -/
theorem cycleGroup_cuspStabilizer (n : List ℕ) (hn : AdmissibleCycle n) :
    cycleGroup n ⊓ Subgroup.zpowers (ModularGroup.T : PSL(2, ℤ)) =
      Subgroup.zpowers ((ModularGroup.T : PSL(2, ℤ)) ^ n.sum) := by
  sorry

/-- The cycle group has infinite index in the modular group. Native subgroup
index is zero exactly when the coset space is infinite. -/
theorem cycleGroup_infiniteIndex (n : List ℕ) (hn : AdmissibleCycle n) :
    (cycleGroup n).index = 0 := by
  sorry

/-! ## Layer 3: conformal recovery of the narrow class -/

/-- Every elliptic fixed point of the cycle group has height at most one.
The points attaining height one are exactly the prefix centres modulo the full
cusp translation period. The identity element is excluded from the fixed-point
witness. This is the arithmetic normalization used in conformal recovery. -/
theorem cycleGroup_highestElliptics (n : List ℕ) (hn : AdmissibleCycle n) :
    (∀ z : UpperHalfPlane,
      (∃ g : cycleGroup n, g ≠ 1 ∧ g • z = z) → z.im ≤ 1) ∧
    {z : UpperHalfPlane | (∃ g : cycleGroup n, g ≠ 1 ∧ g • z = z) ∧ z.im = 1} =
      {z : UpperHalfPlane | ∃ k : Fin n.length, ∃ j : ℤ,
        z.re = ((n.take k.val).sum : ℝ) + (j : ℝ) * (n.sum : ℝ) ∧ z.im = 1} := by
  sorry

end TauCetiRoadmap.FuchsianOrbifoldsPartII
