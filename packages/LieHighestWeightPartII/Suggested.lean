import Mathlib
import TauCeti.Algebra.Lie.InnerAutomorphism

/-!
# Highest weight theory, Part II: target signatures

The roadmap is `README.md`; this file is not the roadmap. It states the roadmap's headline
theorems against the pinned Mathlib and Tau Ceti, each with `sorry`, together with the three
simple definitions they need: zero-inclusive `sl₂`-triples, the group `Int(L)` of inner
automorphisms (the group of LieHighestWeight Layer 7, restated here on linear automorphisms so
that the statements elaborate), and the increasing weight filtration of a triple on a module.

Throughout, `K` is an algebraically closed field of characteristic zero and conjugacy of triples
means conjugacy under `Int(L)`.

Headline theorems that are not statable at the pins:

* **Recognition of the positive real part** (Ciubotaru–Harris, Proposition 10.2; README Layer 5):
  equal geometric weight patterns of two semisimple elements of a connected complex semisimple
  group force their positive real parts to be conjugate. The pins have no connected semisimple
  algebraic group together with its category of finite-dimensional algebraic representations and
  the character lattice of a maximal torus, which the statement quantifies over.
* **Half-spin separation of very even orbits** (Ciubotaru–Harris, Lemma 10.9; README Layer 2), and
  with it the finite test family of README Layer 4 (standard modules, one half-spin module per
  factor of type `D`, adjoint modules of exceptional factors): the pins have half-spin Lie modules
  only on Tau Ceti's Clifford-polarisation carrier, with no Lie algebra isomorphism to Mathlib's
  `LieAlgebra.Orthogonal.so`, and no decomposition of a semisimple Lie algebra into its simple
  ideals with their types.
-/

universe u v

namespace TauCetiRoadmap.LieHighestWeightPartII

open LieModule Module

/-! ## Layer 0: zero-inclusive triples and inner conjugacy -/

/-- A zero-inclusive `sl₂`-triple: the three bracket relations of an `sl₂`-triple `(h, e, f)`,
without Mathlib's condition `h ≠ 0` of `IsSl2Triple`. Over a field of characteristic zero the
only additional solution is `(0, 0, 0)`; it is the triple attached to the zero nilpotent element
(Ciubotaru–Harris, §2.1, relations (2.1)). -/
structure IsSl2TripleOrZero {L : Type*} [LieRing L] (h e f : L) : Prop where
  lie_e_f : ⁅e, f⁆ = h
  lie_h_e_nsmul : ⁅h, e⁆ = 2 • e
  lie_h_f_nsmul : ⁅h, f⁆ = -(2 • f)

/-- The group `Int(L)` of inner automorphisms of a Lie algebra `L` over a field of characteristic
zero: the subgroup of linear automorphisms of `L` generated by the finite exponentials
`exp (ad x)` of the elements `x` whose adjoint action is nilpotent. It is the group `Int(L)` of
LieHighestWeight Layer 7; for a connected semisimple algebraic group `G` with Lie algebra `L` it is
the image of `G(K)` under the adjoint action (README Layer 0). -/
noncomputable def innerAutGroup (K L : Type*) [Field K] [CharZero K] [LieRing L]
    [LieAlgebra K L] : Subgroup (L ≃ₗ[K] L) :=
  letI : LieAlgebra ℚ L := TauCeti.ratLieAlgebra K L
  Subgroup.closure {φ | ∃ (x : L) (hx : IsNilpotent (LieAlgebra.ad K L x)),
    φ = (TauCeti.expAd x hx).toLinearEquiv}

/-! ## Layer 1: representation filtrations -/

/-- The increasing weight filtration of a neutral element `h` on a Lie module `M`: its `i`-th
step is the sum of the eigenspaces of the action of `h` at the integers `j ≤ i`
(Ciubotaru–Harris, §2.2, Definition 2.2). For the neutral element of a zero-inclusive triple on a
finite-dimensional module over an algebraically closed field of characteristic zero the steps are
zero for `i` small and all of `M` for `i` large, and `e` raises the index by two. -/
noncomputable def weightFiltration (K : Type*) {L : Type*} [Field K] [LieRing L]
    [LieAlgebra K L] (h : L) (M : Type*) [AddCommGroup M] [Module K M] [LieRingModule L M]
    [LieModule K L M] (i : ℤ) : Submodule K M :=
  ⨆ (j : ℤ) (_ : j ≤ i), (toEnd K L M h).eigenspace (j : K)

/-- **The filtration determines the restricted `sl₂`-module.** For zero-inclusive triples
`(h, e, f)` in `L` and `(h', e', f')` in `L'`, and finite-dimensional modules `M`, `M'`, the
weight filtrations have the same dimension in every degree if and only if some linear
isomorphism `M ≃ M'` intertwines the actions of `h, e, f` with those of `h', e', f'`
(README Layer 1; Ciubotaru–Harris, proof of Lemma 10.9). -/
theorem finrank_weightFiltration_eq_iff_exists_intertwiner
    {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    {L L' : Type*} [LieRing L] [LieAlgebra K L] [LieRing L'] [LieAlgebra K L']
    {M M' : Type*} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
    [FiniteDimensional K M] [AddCommGroup M'] [Module K M'] [LieRingModule L' M']
    [LieModule K L' M'] [FiniteDimensional K M']
    {h e f : L} {h' e' f' : L'}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f') :
    (∀ i : ℤ, finrank K (weightFiltration K h M i) = finrank K (weightFiltration K h' M' i)) ↔
      ∃ φ : M ≃ₗ[K] M', ∀ m : M,
        φ ⁅h, m⁆ = ⁅h', φ m⁆ ∧ φ ⁅e, m⁆ = ⁅e', φ m⁆ ∧ φ ⁅f, m⁆ = ⁅f', φ m⁆ := sorry

/-! ## Layer 2: classical types -/

/-- **Type `A`: the standard module recognises triples.** In `sl(n, K)`, two zero-inclusive
triples whose weight filtrations on the standard module `Kⁿ` have the same dimensions are
conjugate under `Int(sl(n, K))` (README Layer 2; Ciubotaru–Harris, Lemma 10.9). -/
theorem exists_innerAut_of_finrank_weightFiltration_sl
    {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    {n : Type*} [Fintype n] [DecidableEq n]
    {h e f h' e' f' : LieAlgebra.SpecialLinear.sl n K}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f')
    (hdim : ∀ i : ℤ, finrank K (weightFiltration K h (n → K) i) =
      finrank K (weightFiltration K h' (n → K) i)) :
    ∃ φ ∈ innerAutGroup K (LieAlgebra.SpecialLinear.sl n K),
      φ h = h' ∧ φ e = e' ∧ φ f = f' := sorry

/-- **Type `C`: the standard module recognises triples.** In the symplectic Lie algebra
`sp(2l, K)` acting on `K^(l ⊕ l)`, two zero-inclusive triples whose weight filtrations on the
standard module have the same dimensions are conjugate under `Int(sp(2l, K))` (README Layer 2;
Ciubotaru–Harris, Lemma 10.9). -/
theorem exists_innerAut_of_finrank_weightFiltration_sp
    {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    {l : Type*} [Fintype l] [DecidableEq l]
    {h e f h' e' f' : LieAlgebra.Symplectic.sp l K}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f')
    (hdim : ∀ i : ℤ, finrank K (weightFiltration K h (l ⊕ l → K) i) =
      finrank K (weightFiltration K h' (l ⊕ l → K) i)) :
    ∃ φ ∈ innerAutGroup K (LieAlgebra.Symplectic.sp l K),
      φ h = h' ∧ φ e = e' ∧ φ f = f' := sorry

/-- **Types `B` and `D` away from very even partitions.** In `so(n, K)` acting on `Kⁿ`, two
zero-inclusive triples whose weight filtrations on the standard module have the same dimensions
are conjugate under `Int(so(n, K))`, provided the neutral element `h` has a nonzero kernel on
`Kⁿ`. That proviso says that the Jordan type of `e` has a part of odd size, i.e. is not very even;
it holds whenever `n` is odd. For very even Jordan types the conclusion fails, and README Layer 2
separates the two classes by a half-spin module (Ciubotaru–Harris, Lemma 10.9). -/
theorem exists_innerAut_of_finrank_weightFiltration_so
    {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    {n : Type*} [Fintype n] [DecidableEq n]
    {h e f h' e' f' : LieAlgebra.Orthogonal.so n K}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f')
    (hker : (toEnd K (LieAlgebra.Orthogonal.so n K) (n → K) h).eigenspace 0 ≠ ⊥)
    (hdim : ∀ i : ℤ, finrank K (weightFiltration K h (n → K) i) =
      finrank K (weightFiltration K h' (n → K) i)) :
    ∃ φ ∈ innerAutGroup K (LieAlgebra.Orthogonal.so n K),
      φ h = h' ∧ φ e = e' ∧ φ f = f' := sorry

/-! ## Layer 3: exceptional types -/

/-- **The adjoint module recognises triples in exceptional types.** If `L` is isomorphic to the
split Lie algebra of type `G₂`, `F₄`, `E₆`, `E₇` or `E₈`, two zero-inclusive triples whose weight
filtrations on the adjoint module `L` have the same dimensions are conjugate under `Int(L)`. The
types `E₆` and `E₇` are included and are proved in their own root systems (README Layer 3;
Ciubotaru–Harris, Lemma 10.9 and Tables 2–4). The finite-dimensionality and Killing hypotheses
hold for these algebras; they are carried so that the statement does not depend on Serre's
presentation theorem. -/
theorem exists_innerAut_of_finrank_weightFiltration_adjoint_exceptional
    {K L : Type*} [Field K] [IsAlgClosed K] [CharZero K] [LieRing L] [LieAlgebra K L]
    [FiniteDimensional K L] [LieAlgebra.IsKilling K L]
    (hL : Nonempty (L ≃ₗ⁅K⁆ LieAlgebra.g₂ K) ∨ Nonempty (L ≃ₗ⁅K⁆ LieAlgebra.f₄ K) ∨
      Nonempty (L ≃ₗ⁅K⁆ LieAlgebra.e₆ K) ∨ Nonempty (L ≃ₗ⁅K⁆ LieAlgebra.e₇ K) ∨
      Nonempty (L ≃ₗ⁅K⁆ LieAlgebra.e₈ K))
    {h e f h' e' f' : L}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f')
    (hdim : ∀ i : ℤ, finrank K (weightFiltration K h L i) =
      finrank K (weightFiltration K h' L i)) :
    ∃ φ ∈ innerAutGroup K L, φ h = h' ∧ φ e = e' ∧ φ f = f' := sorry

/-! ## Layer 4: semisimple recognition -/

/-- **Filtration recognition.** In a finite-dimensional semisimple Lie algebra `L` over an
algebraically closed field of characteristic zero, two zero-inclusive triples are conjugate under
`Int(L)` if and only if their weight filtrations have the same dimension in every degree on every
finite-dimensional `L`-module (README Layer 4; Ciubotaru–Harris, Lemma 2.4 and Lemma 10.9). The
modules range over a universe containing `K` and `L`, so that the adjoint module and the modules
`Kⁿ` occur. -/
theorem exists_innerAut_iff_finrank_weightFiltration
    {K : Type u} {L : Type v} [Field K] [IsAlgClosed K] [CharZero K] [LieRing L]
    [LieAlgebra K L] [FiniteDimensional K L] [LieAlgebra.IsKilling K L]
    {h e f h' e' f' : L}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f') :
    (∃ φ ∈ innerAutGroup K L, φ h = h' ∧ φ e = e' ∧ φ f = f') ↔
      ∀ (M : Type (max u v)) [AddCommGroup M] [Module K M] [LieRingModule L M]
        [LieModule K L M] [FiniteDimensional K M] (i : ℤ),
        finrank K (weightFiltration K h M i) = finrank K (weightFiltration K h' M i) := sorry

end TauCetiRoadmap.LieHighestWeightPartII
